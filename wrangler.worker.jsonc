{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dsp-shader-dev",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dsp.ashman.foo",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
